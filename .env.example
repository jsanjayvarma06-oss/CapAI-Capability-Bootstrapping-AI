# Copy this file to .env and fill in your key to enable real LLM-backed
# diagnosis and code generation. Without it, CapAI runs fully offline
# using the heuristic fallback in capai/diagnostic_agent.py and
# capai/code_writer.py.

ANTHROPIC_API_KEY=
CAPAI_MODEL=claude-sonnet-4-6

# Where CapAI stores MCP server workdirs (with their own git repos) and
# the Main Registry's JSON file. Defaults to ./.capai
CAPAI_HOME=.capai

# How many diagnose -> write -> test rounds the Orchestrator will try
# before giving up on a single task.
CAPAI_MAX_ATTEMPTS=3

# Hard timeout (seconds) for any single sandboxed execution.
CAPAI_SANDBOX_TIMEOUT=5
